NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EPICAP_QUOTE_EMAIL=herosqwerty@gmail.com
RESEND_API_KEY=
# Use onboarding@resend.dev only for Resend sandbox tests.
# Production must use an address from a verified domain, for example:
# RESEND_FROM_EMAIL=Epicap <devis@epicap.com>
RESEND_FROM_EMAIL=Epicap <onboarding@resend.dev>

# Sentry error monitoring.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Token serveur avec lecture et écriture sur les issues Sentry.
SENTRY_AUTH_TOKEN=
# Optional for self-hosted Sentry.
SENTRY_API_URL=https://sentry.io

# PostHog product analytics. Leave the key empty to disable PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
# Private PostHog admin API access for the dashboard analytics page.
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
